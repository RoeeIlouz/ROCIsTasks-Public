# ==============================================================================
# ROCIs Tasks Marketing & Feedback Bot Configuration
# ==============================================================================

# Core AI Engine (Required for drafting & community intelligence)
# Get free from https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Telegram Bot (Required for command listener & approval cards)
# 1. Get bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# 2. Your Telegram Chat ID (Optional: bot auto-detects from incoming messages if omitted)
# Get from @userinfobot or message the bot directly
TELEGRAM_CHAT_ID=

# RAS (ROCIs AI System) Integration
# Defaults to http://localhost:3000. Falls back to local git/pubspec telemetry if offline.
RAS_BASE_URL=http://localhost:3000

# Social Platform Credentials (Optional - configure targets you wish to post to)
# Bluesky (AT Protocol)
BSKY_HANDLE=
BSKY_APP_PASSWORD=

# X / Twitter API
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# Mastodon / Fediverse
MASTODON_INSTANCE=https://mastodon.social
MASTODON_ACCESS_TOKEN=

# Threads (Meta)
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# Developer Publishing
DEVTO_API_KEY=
HASHNODE_ACCESS_TOKEN=
HASHNODE_PUBLICATION_ID=

# Reddit API
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=

# Engine Settings
DRY_RUN=false
MAX_DISCOVERIES_PER_RUN=5
MIN_RELEVANCE_SCORE=75

