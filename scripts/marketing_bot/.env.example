# ==============================================================================
# ROCIs Tasks Marketing & Feedback Bot Configuration
# ==============================================================================

# Required: Google Gemini API Key (Get free from https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Required: Telegram Bot Token (Get from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Required: Your personal Telegram Chat ID (Get from @userinfobot on Telegram)
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Optional: Reddit API credentials (Only if you want automated Reddit comments)
# Get from https://www.reddit.com/prefs/apps (script type)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=

# Bot Settings
DRY_RUN=false
MAX_DISCOVERIES_PER_RUN=5
MIN_RELEVANCE_SCORE=75

