rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Reusable functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Billing fields are written only by Cloud Functions (Lemon Squeezy and
    // RevenueCat webhooks, syncPremium), never by clients.
    function billingFields() {
      return ['is_premium', 'subscription_status', 'subscription_id',
        'subscription_ends_at', 'subscription_trial_ends_at', 'ls_subscription_updated_at',
        'ls_subscription_active', 'ls_lifetime', 'rc_premium', 'rc_expires_at',
        'last_billing_sync', 'last_synced_from_mobile'];
    }

    function touchesBilling() {
      return resource == null
        ? request.resource.data.keys().hasAny(billingFields())
        : request.resource.data.diff(resource.data).affectedKeys().hasAny(billingFields());
    }

    match /users/{userId} {
      // Users read/write their own doc, except the billing fields.
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && !touchesBilling();

      // Settings sub-collection
      match /settings/{settingId} {
        allow read, write: if isOwner(userId);
      }

      // Tasks collection
      match /tasks/{taskId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) 
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 100
          && (!request.resource.data.keys().hasAny(['description']) 
              || request.resource.data.description is string 
              && request.resource.data.description.size() <= 1000)
          && request.resource.data.priority is int
          && request.resource.data.priority >= 0
          && request.resource.data.priority <= 3
          && request.resource.data.isCompleted is bool
          && request.resource.data.isDeleted is bool
          && request.resource.data.isPinned is bool
          && (!request.resource.data.keys().hasAny(['dueDate'])
              || request.resource.data.dueDate is timestamp || request.resource.data.dueDate == null)
          && (!request.resource.data.keys().hasAny(['categoryIds'])
              || request.resource.data.categoryIds is list);
      }

      // Categories collection
      match /categories/{categoryId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 50
          && request.resource.data.colorValue is int
          && request.resource.data.iconCode is int
          && (!request.resource.data.keys().hasAny(['description'])
              || request.resource.data.description is string
              && request.resource.data.description.size() <= 200);
      }
    }

    // QR "Cloud Link" shares. A signed-in author creates a snapshot that anyone
    // holding its random ID can open; listing is denied. The app rejects
    // expired shares and a TTL policy on expiresAt deletes them.
    match /shared_tasks/{shareId} {
      allow get: if true;
      allow create: if isAuthenticated()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.id == shareId
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt < request.time + duration.value(8, 'd')
        && request.resource.data.task is map
        && request.resource.data.task.title is string
        && request.resource.data.task.title.size() <= 500;
      allow delete: if isAuthenticated()
        && resource.data.authorId == request.auth.uid;
    }
  }
}
