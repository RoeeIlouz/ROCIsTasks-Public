<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older. flutter_secure_storage values are encrypted with a
     Keystore key that never leaves the device, so a restored copy can't be
     decrypted ("Failed to unwrap key"). Everything else is backed up. -->
<full-backup-content>
    <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
    <exclude domain="sharedpref" path="FlutterSecureStorageConfiguration.xml" />
</full-backup-content>
