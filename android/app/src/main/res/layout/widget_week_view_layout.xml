<?xml version="1.0" encoding="utf-8"?>
<!-- Week View: the app's card (GlassContainer colors synced from MyApp) with a week
     header and the ROCIs Schedule style timetable, drawn by WeekViewRenderer into
     widget_week_grid. The column overlays line up with the drawn day columns (the
     spacer matches WeekViewRenderer.TIME_AXIS_DP) so tapping a day opens it. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_week_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_week_card_fill"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_card_fill"
        android:tint="#FFF5F2FA" />

    <ImageView
        android:id="@+id/widget_week_card_stroke"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_card_stroke"
        android:tint="#1F6366F1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:id="@+id/widget_week_header"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginBottom="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/widget_week_title_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:paddingStart="4dp">

                <TextView
                    android:id="@+id/widget_week_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.03"
                    android:maxLines="1"
                    android:text="Oct 4 – 10"
                    android:textColor="#FF1B1B21"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_week_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="This week"
                    android:textColor="#FF1B1B21"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/widget_week_prev"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:clickable="true"
                android:focusable="true"
                android:padding="6dp"
                android:src="@drawable/ic_chevron_left_24"
                android:tint="#FF1B1B21" />

            <ImageView
                android:id="@+id/widget_week_next"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:clickable="true"
                android:focusable="true"
                android:padding="6dp"
                android:src="@drawable/ic_chevron_right_24"
                android:tint="#FF1B1B21" />

            <ImageView
                android:id="@+id/widget_week_jump_btn"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:clickable="true"
                android:focusable="true"
                android:padding="7dp"
                android:src="@drawable/ic_today_24"
                android:tint="#FF1B1B21" />

            <ImageView
                android:id="@+id/widget_week_add_btn"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:clickable="true"
                android:focusable="true"
                android:padding="6dp"
                android:src="@drawable/ic_add"
                android:tint="#FF1B1B21" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/widget_week_grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <!-- FrameLayout, not View: RemoteViews refuses to inflate a plain View. -->
                <FrameLayout
                    android:layout_width="26dp"
                    android:layout_height="match_parent" />

                <FrameLayout android:id="@+id/widget_week_col_0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:clickable="true" android:focusable="true" />
                <FrameLayout android:id="@+id/widget_week_col_1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:clickable="true" android:focusable="true" />
                <FrameLayout android:id="@+id/widget_week_col_2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:clickable="true" android:focusable="true" />
                <FrameLayout android:id="@+id/widget_week_col_3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:clickable="true" android:focusable="true" />
                <FrameLayout android:id="@+id/widget_week_col_4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:clickable="true" android:focusable="true" />
                <FrameLayout android:id="@+id/widget_week_col_5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:clickable="true" android:focusable="true" />
                <FrameLayout android:id="@+id/widget_week_col_6" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:clickable="true" android:focusable="true" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <include layout="@layout/widget_pro_overlay" />
</FrameLayout>
