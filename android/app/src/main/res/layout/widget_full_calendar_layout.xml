<?xml version="1.0" encoding="utf-8"?>
<!-- FullCalendar widget: mirrors the in-app CalendarScreen card (GlassContainer:
     surfaceContainerLow fill, primary-tinted border, 24dp corners). Colors are
     applied at runtime from the app's synced theme. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_full_calendar_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_fc_card_fill"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_card_fill"
            android:tint="#FFF5F2FA" />

    <ImageView
        android:id="@+id/widget_fc_card_stroke"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_card_stroke"
            android:tint="#1F6366F1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        android:paddingTop="10dp"
        android:paddingBottom="8dp">

        <!-- Header: title + actions (like the app's header row) -->
        <LinearLayout
            android:id="@+id/widget_full_calendar_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView android:textColor="#FF1B1B21"
                android:id="@+id/widget_full_calendar_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:ellipsize="end"
                android:focusable="true"
                android:fontFamily="sans-serif"
            android:textStyle="bold"
                android:letterSpacing="-0.03"
                android:maxLines="1"
                android:paddingStart="4dp"
                android:text="October 2026"
                android:textSize="18sp" />

            <ImageView
                android:id="@+id/widget_full_calendar_prev"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="6dp"
                android:src="@drawable/ic_chevron_left_24"
            android:tint="#FF1B1B21"
                android:clickable="true"
                android:focusable="true" />

            <ImageView
                android:id="@+id/widget_full_calendar_next"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="6dp"
                android:src="@drawable/ic_chevron_right_24"
            android:tint="#FF1B1B21"
                android:clickable="true"
                android:focusable="true" />

            <ImageView
                android:id="@+id/widget_full_calendar_today"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="7dp"
                android:src="@drawable/ic_today_24"
            android:tint="#FF1B1B21"
                android:clickable="true"
                android:focusable="true" />

            <ImageView
                android:id="@+id/widget_add_task_btn"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="6dp"
                android:src="@drawable/ic_add"
            android:tint="#FF1B1B21"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Source filters (widget-only) -->
        <LinearLayout
            android:id="@+id/widget_full_calendar_filters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingTop="2dp"
            android:paddingBottom="6dp">

            <FrameLayout
                android:id="@+id/widget_filter_tasks"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:id="@+id/widget_filter_tasks_fill"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    android:src="@drawable/widget_chip_fill"
            android:tint="#1F6366F1" />
                <ImageView
                    android:id="@+id/widget_filter_tasks_stroke"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    android:src="@drawable/widget_chip_stroke"
            android:tint="#596366F1" />
                <TextView android:textColor="#FF1B1B21"
                    android:id="@+id/widget_filter_tasks_text"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="Tasks"
                    android:textSize="11sp" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/widget_filter_google"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:id="@+id/widget_filter_google_fill"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    android:src="@drawable/widget_chip_fill"
            android:tint="#1F6366F1" />
                <ImageView
                    android:id="@+id/widget_filter_google_stroke"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    android:src="@drawable/widget_chip_stroke"
            android:tint="#596366F1" />
                <TextView android:textColor="#FF1B1B21"
                    android:id="@+id/widget_filter_google_text"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="Google"
                    android:textSize="11sp" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/widget_filter_rocis"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:id="@+id/widget_filter_rocis_fill"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    android:src="@drawable/widget_chip_fill"
            android:tint="#1F6366F1" />
                <ImageView
                    android:id="@+id/widget_filter_rocis_stroke"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    android:src="@drawable/widget_chip_stroke"
            android:tint="#596366F1" />
                <TextView android:textColor="#FF1B1B21"
                    android:id="@+id/widget_filter_rocis_text"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="Schedule"
                    android:textSize="11sp" />
            </FrameLayout>
        </LinearLayout>

        <!-- Weekday header -->
        <LinearLayout
            android:id="@+id/widget_full_calendar_weekdays"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:orientation="horizontal">

            <TextView android:textColor="#FF1B1B21" android:id="@+id/widget_weekday_num_header" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.6" android:gravity="center" android:text="#" android:textSize="11sp" android:fontFamily="sans-serif" android:visibility="gone" />
            <TextView android:textColor="#FF1B1B21" android:id="@+id/widget_weekday_sun_header" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Sun" android:textSize="12sp" android:fontFamily="sans-serif" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <TextView android:textColor="#FF1B1B21" android:id="@+id/widget_weekday_mon_header" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Mon" android:textSize="12sp" android:fontFamily="sans-serif" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <TextView android:textColor="#FF1B1B21" android:id="@+id/widget_weekday_tue_header" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Tue" android:textSize="12sp" android:fontFamily="sans-serif" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <TextView android:textColor="#FF1B1B21" android:id="@+id/widget_weekday_wed_header" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Wed" android:textSize="12sp" android:fontFamily="sans-serif" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <TextView android:textColor="#FF1B1B21" android:id="@+id/widget_weekday_thu_header" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Thu" android:textSize="12sp" android:fontFamily="sans-serif" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <TextView android:textColor="#FF1B1B21" android:id="@+id/widget_weekday_fri_header" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Fri" android:textSize="12sp" android:fontFamily="sans-serif" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <TextView android:textColor="#FF1B1B21" android:id="@+id/widget_weekday_sat_header" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Sat" android:textSize="12sp" android:fontFamily="sans-serif" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>

        <!-- Week rows are added at runtime (4-6, like the app) and share the height -->
        <LinearLayout
            android:id="@+id/widget_full_calendar_grid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical" />
    </LinearLayout>

    <!-- Premium Overlay -->
    <RelativeLayout
        android:id="@+id/widget_premium_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#D9000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_premium_overlay_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:fontFamily="sans-serif"
            android:textStyle="bold"
            android:gravity="center"
            android:text="Premium Feature"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />
    </RelativeLayout>
</FrameLayout>
