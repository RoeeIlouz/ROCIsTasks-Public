<?xml version="1.0" encoding="utf-8"?>
<!-- Month Agenda: the app's card with a compact month grid (like the FullCalendar widget)
     beside the selected day's tasks/events (like Today Agenda). Colors are applied at runtime. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_month_agenda_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_month_agenda_card_fill"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_card_fill" />

    <ImageView
        android:id="@+id/widget_month_agenda_card_stroke"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_card_stroke" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        android:paddingTop="10dp"
        android:paddingBottom="8dp">

        <!-- Header: month title + actions -->
        <LinearLayout
            android:id="@+id/widget_month_agenda_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/widget_month_agenda_month_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:ellipsize="end"
                android:focusable="true"
                android:fontFamily="@font/outfit_bold"
                android:includeFontPadding="false"
                android:letterSpacing="-0.03"
                android:maxLines="1"
                android:paddingStart="4dp"
                android:text="September 2026"
                android:textAlignment="viewStart"
                android:textSize="18sp" />

            <ImageView
                android:id="@+id/widget_month_agenda_prev"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:clickable="true"
                android:focusable="true"
                android:padding="6dp"
                android:src="@drawable/ic_chevron_left_24" />

            <ImageView
                android:id="@+id/widget_month_agenda_next"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:clickable="true"
                android:focusable="true"
                android:padding="6dp"
                android:src="@drawable/ic_chevron_right_24" />

            <ImageView
                android:id="@+id/widget_month_agenda_today_btn"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:clickable="true"
                android:focusable="true"
                android:padding="7dp"
                android:src="@drawable/ic_today_24" />

            <ImageView
                android:id="@+id/widget_month_agenda_add_btn"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:clickable="true"
                android:focusable="true"
                android:padding="6dp"
                android:src="@drawable/ic_add" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- Month grid -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/widget_month_agenda_weekdays"
                    android:layout_width="match_parent"
                    android:layout_height="20dp"
                    android:orientation="horizontal">

                    <TextView android:id="@+id/widget_month_agenda_wd_0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:ellipsize="end" android:fontFamily="@font/outfit_bold" android:gravity="center" android:maxLines="1" android:text="S" android:textSize="11sp" />
                    <TextView android:id="@+id/widget_month_agenda_wd_1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:ellipsize="end" android:fontFamily="@font/outfit_bold" android:gravity="center" android:maxLines="1" android:text="M" android:textSize="11sp" />
                    <TextView android:id="@+id/widget_month_agenda_wd_2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:ellipsize="end" android:fontFamily="@font/outfit_bold" android:gravity="center" android:maxLines="1" android:text="T" android:textSize="11sp" />
                    <TextView android:id="@+id/widget_month_agenda_wd_3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:ellipsize="end" android:fontFamily="@font/outfit_bold" android:gravity="center" android:maxLines="1" android:text="W" android:textSize="11sp" />
                    <TextView android:id="@+id/widget_month_agenda_wd_4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:ellipsize="end" android:fontFamily="@font/outfit_bold" android:gravity="center" android:maxLines="1" android:text="T" android:textSize="11sp" />
                    <TextView android:id="@+id/widget_month_agenda_wd_5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:ellipsize="end" android:fontFamily="@font/outfit_bold" android:gravity="center" android:maxLines="1" android:text="F" android:textSize="11sp" />
                    <TextView android:id="@+id/widget_month_agenda_wd_6" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:ellipsize="end" android:fontFamily="@font/outfit_bold" android:gravity="center" android:maxLines="1" android:text="S" android:textSize="11sp" />
                </LinearLayout>

                <!-- Week rows are added at runtime (4-6, like the app) and share the height -->
                <LinearLayout
                    android:id="@+id/widget_month_agenda_grid"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="vertical" />
            </LinearLayout>

            <ImageView
                android:id="@+id/widget_month_agenda_divider"
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="8dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:scaleType="fitXY"
                android:src="@drawable/widget_accent_bar" />

            <!-- Selected day agenda -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/widget_month_agenda_day_header"
                    android:layout_width="match_parent"
                    android:layout_height="20dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/widget_month_agenda_selected_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="@font/outfit_semibold"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="Thu, Sep 24"
                        android:textAlignment="viewStart"
                        android:textSize="13sp" />

                    <FrameLayout
                        android:id="@+id/widget_month_agenda_selected_chip"
                        android:layout_width="wrap_content"
                        android:layout_height="18dp"
                        android:layout_marginStart="4dp"
                        android:visibility="gone">

                        <ImageView
                            android:id="@+id/widget_month_agenda_selected_chip_fill"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="fitXY"
                            android:src="@drawable/widget_chip_fill" />

                        <TextView
                            android:id="@+id/widget_month_agenda_selected_subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:fontFamily="@font/outfit_semibold"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:paddingStart="7dp"
                            android:paddingEnd="7dp"
                            android:text="Today"
                            android:textSize="10sp" />
                    </FrameLayout>
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="4dp">

                    <ListView
                        android:id="@+id/widget_month_agenda_list"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:divider="@null"
                        android:dividerHeight="5dp"
                        android:scrollbars="none" />

                    <LinearLayout
                        android:id="@+id/widget_month_agenda_empty"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="8dp"
                        android:visibility="gone">

                        <ImageView
                            android:id="@+id/widget_month_agenda_empty_icon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginBottom="6dp"
                            android:src="@drawable/ic_widget_check_on" />

                        <TextView
                            android:id="@+id/widget_month_agenda_empty_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/outfit_semibold"
                            android:gravity="center"
                            android:text="No events or tasks"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/widget_month_agenda_empty_subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/outfit_regular"
                            android:gravity="center"
                            android:text="Tap + to add a task"
                            android:textSize="11sp" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <include layout="@layout/widget_pro_overlay" />
</FrameLayout>
