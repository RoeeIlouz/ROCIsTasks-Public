<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_full_calendar_day_container"
    android:layout_width="0dp"
    android:layout_height="75dp"
    android:layout_weight="1"
    android:padding="2dp">

    <!-- Background fill for today (dynamic tinting) -->
    <ImageView
        android:id="@+id/widget_full_calendar_day_fill"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/widget_day_fill"
        android:scaleType="fitXY"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_marginTop="2dp"
        android:gravity="center_horizontal">

        <!-- Top Area: Day Number -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="4dp">
            
            <!-- Today highlight circle behind the text -->
            <ImageView
                android:id="@+id/widget_full_calendar_today_circle"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center_horizontal"
                android:src="@drawable/widget_today_circle"
                android:visibility="gone" />
            
            <TextView
                android:id="@+id/widget_full_calendar_day_text"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:text="1"
                android:textSize="12sp"
                android:textStyle="normal"
                android:textColor="@color/widget_title_text"
                android:gravity="center"
                android:layout_gravity="center_horizontal" />
        </FrameLayout>

        <!-- Bottom Area: Event Indicators or Title -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingTop="1dp">

            <!-- Single Event Title (Visible when count == 1) -->
            <TextView
                android:id="@+id/widget_full_calendar_day_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="8sp"
                android:gravity="center"
                android:maxLines="2"
                android:ellipsize="end"
                android:textColor="@color/widget_title_text"
                android:visibility="gone" />

            <!-- Multiple Event Lines (Visible when count > 1) -->
            <LinearLayout
                android:id="@+id/widget_full_calendar_indicators_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">
                
                <ImageView
                    android:id="@+id/widget_full_calendar_summary_1"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_marginBottom="2dp"
                    android:src="@drawable/widget_item_background"
                    android:scaleType="fitXY"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/widget_full_calendar_summary_2"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_marginBottom="2dp"
                    android:src="@drawable/widget_item_background"
                    android:scaleType="fitXY"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/widget_full_calendar_summary_3"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:src="@drawable/widget_item_background"
                    android:scaleType="fitXY"
                    android:visibility="gone" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
