<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_task_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/widget_card_bg"
    android:layout_marginTop="2dp"
    android:layout_marginBottom="2dp"
    android:layout_marginStart="2dp"
    android:layout_marginEnd="2dp"
    android:paddingStart="4dp"
    android:paddingEnd="10dp"
    android:paddingTop="7dp"
    android:paddingBottom="7dp">

    <!-- Category Accent Strip -->
    <FrameLayout
        android:id="@+id/widget_task_category_color"
        android:layout_width="3.5dp"
        android:layout_height="30dp"
        android:background="@color/widget_primary"
        android:layout_marginEnd="8dp" />

    <!-- Checkbox Icon -->
    <ImageView
        android:id="@+id/widget_task_check"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_circle_outline"
        android:contentDescription="Complete Task"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginEnd="10dp" />

    <!-- Task Details -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_task_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Task Title"
            android:textSize="13.5sp"
            android:fontFamily="sans-serif"
            android:textColor="@color/widget_title_text"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="2dp">

            <TextView
                android:id="@+id/widget_task_meta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Category • High"
                android:textSize="11sp"
                android:textColor="@color/widget_secondary_text"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_task_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Today"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/widget_secondary_text"
                android:layout_marginStart="6dp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
