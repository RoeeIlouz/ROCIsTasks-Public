<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_task_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="0dp"
    android:gravity="fill_vertical">

    <FrameLayout
        android:id="@+id/widget_task_category_color"
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:background="@color/widget_primary"
        android:layout_marginEnd="8dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:gravity="center_vertical">

    <ImageView
        android:id="@+id/widget_task_check"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_check_circle_outline"
        android:contentDescription="Complete Task"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginEnd="8dp"
        android:tint="@color/widget_primary"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

            <TextView
                android:id="@+id/widget_task_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Task Title"
                android:textSize="14sp" 
                android:textColor="@color/widget_title_text"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/widget_task_meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Category • High"
                android:textSize="11sp"
                android:textColor="@color/widget_body_text"/>

            <TextView
                android:id="@+id/widget_task_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Today"
                android:textSize="12sp"
                android:textColor="@color/widget_body_text"/>
    </LinearLayout>

    </LinearLayout>
</LinearLayout>
