<?xml version="1.0" encoding="utf-8"?>
<!-- Today Agenda: the app's card (GlassContainer colors synced from MyApp) with a
     day header and the day's tasks/events. Colors are applied at runtime. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_today_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_today_card_fill"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_card_fill"
            android:tint="#FFF5F2FA" />

    <ImageView
        android:id="@+id/widget_today_card_stroke"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_card_stroke"
            android:tint="#1F6366F1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        android:paddingTop="10dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:id="@+id/widget_today_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="6dp">

            <LinearLayout
                android:id="@+id/widget_today_title_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:paddingStart="4dp">

                <TextView android:textColor="#FF1B1B21"
                    android:id="@+id/widget_today_date_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif"
            android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.03"
                    android:maxLines="1"
                    android:text="Thursday, Sep 24"
                    android:textSize="18sp" />

                <TextView android:textColor="#FF1B1B21"
                    android:id="@+id/widget_today_date_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="Today"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/widget_today_prev"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:clickable="true"
                android:focusable="true"
                android:padding="6dp"
                android:src="@drawable/ic_chevron_left_24"
            android:tint="#FF1B1B21" />

            <ImageView
                android:id="@+id/widget_today_next"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:clickable="true"
                android:focusable="true"
                android:padding="6dp"
                android:src="@drawable/ic_chevron_right_24"
            android:tint="#FF1B1B21" />

            <ImageView
                android:id="@+id/widget_today_jump_btn"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:clickable="true"
                android:focusable="true"
                android:padding="7dp"
                android:src="@drawable/ic_today_24"
            android:tint="#FF1B1B21" />

            <ImageView
                android:id="@+id/widget_today_add_btn"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:clickable="true"
                android:focusable="true"
                android:padding="6dp"
                android:src="@drawable/ic_add"
            android:tint="#FF1B1B21" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ListView
                android:id="@+id/widget_today_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:divider="@null"
                android:dividerHeight="6dp"
                android:paddingEnd="4dp"
                android:scrollbars="none" />

            <LinearLayout
                android:id="@+id/widget_today_empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="12dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/widget_today_empty_icon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginBottom="6dp"
                    android:src="@drawable/ic_widget_check_on"
            android:tint="#FF6366F1" />

                <TextView android:textColor="#FF1B1B21"
                    android:id="@+id/widget_today_empty_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="No tasks or events"
                    android:textSize="14sp" />

                <TextView android:textColor="#FF1B1B21"
                    android:id="@+id/widget_today_empty_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:text="Tap + to add a task"
                    android:textSize="12sp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <include layout="@layout/widget_pro_overlay" />
</FrameLayout>
