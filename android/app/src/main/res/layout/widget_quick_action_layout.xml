<?xml version="1.0" encoding="utf-8"?>
<!-- Quick Actions: the app's card with today's progress ring (pending count inside,
     completed count below) and action tiles. Colors are applied at runtime. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_quick_action_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_quick_card_fill"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_card_fill"
            android:tint="#FFF5F2FA" />

    <ImageView
        android:id="@+id/widget_quick_card_stroke"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_card_stroke"
            android:tint="#1F6366F1" />

    <LinearLayout
        android:id="@+id/widget_quick_action_main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <!-- Progress: ring with today's pending count, completed count below. -->
        <LinearLayout
            android:id="@+id/widget_quick_progress_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="2dp"
            android:paddingEnd="2dp">

            <FrameLayout
                android:layout_width="60dp"
                android:layout_height="60dp">

                <ImageView
                    android:id="@+id/widget_quick_ring"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter" />

                <LinearLayout
                    android:id="@+id/widget_quick_stat_container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView android:textColor="#FF1B1B21"
                        android:id="@+id/widget_quick_stat_number"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
            android:textStyle="bold"
                        android:includeFontPadding="false"
                        android:letterSpacing="-0.03"
                        android:maxLines="1"
                        android:text="3"
                        android:textSize="20sp" />

                    <TextView android:textColor="#FF1B1B21"
                        android:id="@+id/widget_quick_stat_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:maxWidth="46dp"
                        android:text="Left"
                        android:textSize="10sp" />
                </LinearLayout>
            </FrameLayout>

            <TextView android:textColor="#FF1B1B21"
                android:id="@+id/widget_quick_done_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:maxWidth="72dp"
                android:text="2 done"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Action tiles -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/widget_quick_btn_add_task"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/widget_quick_btn_add_fill"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    android:src="@drawable/widget_item_fill"
            android:tint="#0D1B1B21" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingEnd="10dp">

                    <ImageView
                        android:id="@+id/widget_quick_btn_add_icon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_add"
            android:tint="#FF1B1B21" />

                    <TextView android:textColor="#FF1B1B21"
                        android:id="@+id/widget_quick_btn_add_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="New Task"
                        android:textAlignment="viewStart"
                        android:textSize="13sp" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:id="@+id/widget_quick_btn_calendar"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="6dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/widget_quick_btn_cal_fill"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    android:src="@drawable/widget_item_fill"
            android:tint="#0D1B1B21" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingEnd="10dp">

                    <ImageView
                        android:id="@+id/widget_quick_calendar_icon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:padding="1dp"
                        android:src="@drawable/ic_today_24"
            android:tint="#FF1B1B21" />

                    <TextView android:textColor="#FF1B1B21"
                        android:id="@+id/widget_quick_btn_cal_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="Calendar"
                        android:textAlignment="viewStart"
                        android:textSize="13sp" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <include layout="@layout/widget_pro_overlay" />
</FrameLayout>
