<?xml version="1.0" encoding="utf-8"?>
<!-- Timeline day section: day label ("Today" in the accent), a hairline and the date on
     the end side. Tapping it opens the in-app calendar on that day. Colored by the factory. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_timeline_section_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingTop="10dp"
    android:paddingBottom="4dp">

    <TextView android:textColor="#FF1B1B21"
        android:id="@+id/widget_timeline_section_day"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="sans-serif"
            android:textStyle="bold"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="Today"
        android:textAlignment="viewStart"
        android:textSize="13sp" />

    <FrameLayout
        android:id="@+id/widget_timeline_section_line"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1" />

    <TextView android:textColor="#FF1B1B21"
        android:id="@+id/widget_timeline_section_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="Sep 24"
        android:textSize="12sp" />
</LinearLayout>
