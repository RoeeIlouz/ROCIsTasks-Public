<?xml version="1.0" encoding="utf-8"?>
<!--Full Month Widget without plus icon-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="8dp">
    <!--Month Header-->
    <LinearLayout
        android:id="@+id/widget_month_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">
        <!--Month Navigation-->
        <TextView
            android:id="@+id/widget_prev_month"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="❮"
            android:textColor="@color/widget_title_text"
            android:textSize="18sp"
            android:textStyle="bold"
            android:background="?android:attr/selectableItemBackgroundBorderless" />

        <TextView
            android:id="@+id/widget_month_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-bold"
            android:gravity="center"
            android:text="Month Year"
            android:textColor="@color/widget_title_text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_next_month"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="❯"
            android:textColor="@color/widget_title_text"
            android:textSize="18sp"
            android:textStyle="bold"
            android:background="?android:attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <!-- Weekday Headers -->
    <LinearLayout
        android:id="@+id/widget_month_weekdays"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_below="@id/widget_month_header"
        android:weightSum="8"
        android:paddingBottom="4dp">

        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="#" android:textSize="10sp" android:textColor="@color/widget_secondary_text" android:textStyle="italic"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="S" android:textSize="11sp" android:textColor="@color/widget_body_text"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="M" android:textSize="11sp" android:textColor="@color/widget_body_text"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="T" android:textSize="11sp" android:textColor="@color/widget_body_text"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="W" android:textSize="11sp" android:textColor="@color/widget_body_text"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="T" android:textSize="11sp" android:textColor="@color/widget_body_text"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="F" android:textSize="11sp" android:textColor="@color/widget_body_text"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="S" android:textSize="11sp" android:textColor="@color/widget_body_text"/>
        
    </LinearLayout>
    <!--Month Grid-->
    <GridView
        android:id="@+id/widget_month_grid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/widget_month_weekdays"
        android:layout_alignParentBottom="true"
        android:numColumns="8"
        android:verticalSpacing="1dp"
        android:horizontalSpacing="1dp"
        android:stretchMode="columnWidth"
        android:gravity="center"
        android:listSelector="@android:color/transparent" />

</RelativeLayout>
