<?xml version="1.0" encoding="utf-8"?>
<!-- Up Next: the app's card with the single next task/event (color bar, checkbox or
     event glyph, title, meta line and a relative-time chip). Colors are applied at runtime. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_up_next_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_up_next_card_fill"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_card_fill" />

    <ImageView
        android:id="@+id/widget_up_next_card_stroke"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_card_stroke" />

    <LinearLayout
        android:id="@+id/widget_up_next_main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <ImageView
            android:id="@+id/widget_up_next_check"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:clickable="true"
            android:contentDescription="Complete task"
            android:focusable="true"
            android:padding="9dp"
            android:src="@drawable/ic_widget_check_off" />

        <ImageView
            android:id="@+id/widget_up_next_event_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="Event"
            android:padding="10dp"
            android:src="@drawable/ic_widget_event"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/widget_up_next_done_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="All caught up"
            android:padding="8dp"
            android:src="@drawable/ic_widget_check_on"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="2dp">

            <TextView
                android:id="@+id/widget_up_next_header_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/outfit_semibold"
                android:includeFontPadding="false"
                android:letterSpacing="0.06"
                android:maxLines="1"
                android:text="UP NEXT"
                android:textAlignment="viewStart"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/widget_up_next_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="@font/outfit_semibold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="Next task or meeting"
                android:textAlignment="viewStart"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/widget_up_next_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="@font/outfit_regular"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="Work"
                android:textAlignment="viewStart"
                android:textSize="12sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/widget_up_next_time_box"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:layout_marginStart="8dp">

            <ImageView
                android:id="@+id/widget_up_next_time_fill"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/widget_chip_fill" />

            <TextView
                android:id="@+id/widget_up_next_time_badge"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:fontFamily="@font/outfit_semibold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="in 25 min"
                android:textSize="12sp" />
        </FrameLayout>

        <ImageView
            android:id="@+id/widget_up_next_add_btn"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:clickable="true"
            android:contentDescription="Add task"
            android:focusable="true"
            android:padding="6dp"
            android:src="@drawable/ic_add"
            android:visibility="gone" />
    </LinearLayout>

    <include layout="@layout/widget_pro_overlay" />
</FrameLayout>
