<?xml version="1.0" encoding="utf-8"?>
<!-- One timeline row (same design as widget_today_agenda_item): tinted tile, category
     color bar, checkbox (tasks) or event glyph, title and time/meta line, optional
     priority chip. The root's vertical padding spaces the rows. Colored by the factory. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_timeline_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="3dp"
    android:paddingBottom="3dp">

    <ImageView
        android:id="@+id/widget_timeline_item_fill"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_item_fill" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <ImageView
            android:id="@+id/widget_timeline_color_strip"
            android:layout_width="4dp"
            android:layout_height="28dp"
            android:scaleType="fitXY"
            android:src="@drawable/widget_accent_bar" />

        <ImageView
            android:id="@+id/widget_timeline_check"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:clickable="true"
            android:contentDescription="Complete task"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_widget_check_off" />

        <ImageView
            android:id="@+id/widget_timeline_event_icon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="Event"
            android:padding="9dp"
            android:src="@drawable/ic_widget_event"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="2dp">

            <TextView
                android:id="@+id/widget_timeline_item_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/outfit_semibold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="Task or event title"
                android:textAlignment="viewStart"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_timeline_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/outfit_semibold"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="09:00-10:00"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/widget_timeline_subtitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/outfit_regular"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="Work"
                    android:textAlignment="viewStart"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/widget_timeline_badge_box"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_marginStart="6dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/widget_timeline_badge_fill"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/widget_chip_fill" />

            <TextView
                android:id="@+id/widget_timeline_badge"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:fontFamily="@font/outfit_semibold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="High"
                android:textSize="10sp" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
