<?xml version="1.0" encoding="utf-8"?>
<!-- Pending Tasks: the app's card (GlassContainer colors synced from MyApp) with a header,
     sort/filter chips and the pending task list. Colors are applied at runtime. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_tasklist_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_tasklist_card_fill"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_card_fill"
            android:tint="#FFF5F2FA" />

    <ImageView
        android:id="@+id/widget_tasklist_card_stroke"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_card_stroke"
            android:tint="#1F6366F1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        android:paddingTop="10dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:id="@+id/widget_tasklist_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="4dp">

                <TextView android:textColor="#FF1B1B21"
                    android:id="@+id/widget_tasklist_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif"
            android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.03"
                    android:maxLines="1"
                    android:text="Pending Tasks"
                    android:textAlignment="viewStart"
                    android:textSize="18sp" />

                <TextView android:textColor="#FF1B1B21"
                    android:id="@+id/widget_tasklist_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="0"
                    android:textSize="14sp"
                    android:visibility="gone" />
            </LinearLayout>

            <ImageView
                android:id="@+id/widget_tasklist_add_btn"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:clickable="true"
                android:focusable="true"
                android:padding="6dp"
                android:src="@drawable/ic_add"
            android:tint="#FF1B1B21" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_tasklist_chips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="2dp"
            android:paddingTop="2dp"
            android:paddingBottom="6dp">

            <FrameLayout
                android:id="@+id/widget_btn_sort"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/widget_tasklist_sort_fill"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    android:src="@drawable/widget_chip_fill"
            android:tint="#1F6366F1" />

                <ImageView
                    android:id="@+id/widget_tasklist_sort_stroke"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    android:src="@drawable/widget_chip_stroke"
            android:tint="#596366F1" />

                <TextView android:textColor="#FF1B1B21"
                    android:id="@+id/widget_tasklist_sort_text"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:maxWidth="150dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="Sort: Date"
                    android:textSize="11sp" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/widget_btn_filter"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/widget_tasklist_filter_fill"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    android:src="@drawable/widget_chip_fill"
            android:tint="#1F6366F1" />

                <ImageView
                    android:id="@+id/widget_tasklist_filter_stroke"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    android:src="@drawable/widget_chip_stroke"
            android:tint="#596366F1" />

                <TextView android:textColor="#FF1B1B21"
                    android:id="@+id/widget_tasklist_filter_text"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:maxWidth="170dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="Filter: All"
                    android:textSize="11sp" />
            </FrameLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ListView
                android:id="@+id/widget_list_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:divider="@null"
                android:dividerHeight="6dp"
                android:paddingEnd="4dp"
                android:scrollbars="none" />

            <LinearLayout
                android:id="@+id/widget_tasklist_empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="12dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/widget_tasklist_empty_icon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginBottom="6dp"
                    android:src="@drawable/ic_widget_check_on"
            android:tint="#FF6366F1" />

                <TextView android:textColor="#FF1B1B21"
                    android:id="@+id/widget_tasklist_empty_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="No pending tasks"
                    android:textSize="14sp" />

                <TextView android:textColor="#FF1B1B21"
                    android:id="@+id/widget_tasklist_empty_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:text="Tap + to add a task"
                    android:textSize="12sp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <include layout="@layout/widget_pro_overlay" />
</FrameLayout>
